# Copy to .env (git-ignored) and fill in. Never commit a real key.

# Refine's model: a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional: browser origins allowed to call the API directly (comma-separated).
# Not needed in development: the studio's dev server proxies /api.
ALLOWED_ORIGINS=
# Optional: port (default 8787)
PORT=
